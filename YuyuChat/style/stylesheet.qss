#add_friend_button {
    background-color: #1AAD19; /* 微信绿 */
    color: white;
    border: none;
    border-radius: 5px;
    font-size: 14px;
}

#add_friend_button:hover {
    background-color: #129611; /* 悬浮加深 */
}

#add_friend_button:pressed {
    background-color: #0F790E; /* 按下更深 */
}

#ApplyFriend {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
}

QLineEdit {
    border: 1px solid #d9d9d9;
    border-radius: 4px;
    padding: 5px;
    background-color: #f9f9f9;
    color: #333333;
}
QLineEdit:focus {
    border: 1px solid #1AAD19; /* 聚焦时变绿 */
    background-color: #ffffff;
}

/* 动态添加的已选标签 */
#FriendLabel {
    background-color: #e6f3e6; /* 极浅的绿色背景 */
    border: 1px solid #1AAD19;
    border-radius: 12px;
    padding: 4px 10px;
    color: #1AAD19;
}
#FriendLabel:hover {
    background-color: #ffcccc; /* 悬浮时变红提示可删除 */
    border: 1px solid #ff4d4d;
    color: #ff4d4d;
}

/* 下方推荐的标签墙 */
#tipslb {
    background-color: #f0f0f0;
    border: none;
    border-radius: 12px;
    padding: 4px 12px;
    color: #555555;
}
#tipslb[selected="true"] {
    background-color: #1AAD19; /* 选中时变成主题绿 */
    color: #ffffff;
}

#label_edit {
    border: none;
    background: transparent;
    padding: 0px;
}